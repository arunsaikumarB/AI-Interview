{
  "name": "ai-recruitment-os",
  "version": "0.1.0",
  "private": true,
  "description": "Logisoft HireOS — AI Recruitment Operating System. Intelligent hiring. Human decisions.",
  "scripts": {
    "predev": "node scripts/ensure-local-db.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "db:ensure": "node scripts/ensure-local-db.mjs",
    "https:certs": "node scripts/ensure-local-https.mjs",
    "https:up": "node scripts/ensure-lan-https-proxy.mjs",
    "db:up": "node scripts/ensure-local-db.mjs",
    "db:down": "docker compose --env-file .env.docker --env-file .env stop postgres",
    "pilot:up": "docker compose --env-file .env.docker --env-file .env up -d --build",
    "pilot:down": "docker compose --env-file .env.docker --env-file .env down",
    "pilot:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-pilot.ps1",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "embed:backfill": "tsx scripts/backfill-embeddings.ts",
    "test:isolation": "node --import ./tests/isolation/load-env.mjs --test tests/isolation/phase9-isolation.test.mjs tests/isolation/deactivated-session.test.mjs tests/isolation/secondary-audit-evidence.test.mjs",
    "test:cv": "tsx --test tests/unit/secondary-integrity-cv.test.ts",
    "test:unit": "tsx --test tests/unit/device-interaction-continuity.test.ts tests/unit/device-presence-continuity.test.ts tests/unit/detector-vocabulary.test.ts tests/unit/secondary-audit-evidence.test.ts tests/unit/secondary-integrity-f05.test.ts tests/unit/secondary-camera-connect-dedupe.test.ts tests/unit/job-form-department.test.ts tests/unit/secondary-integrity-cv.test.ts tests/unit/orb-state.test.ts tests/unit/staff-reads.test.ts tests/unit/staff-async.test.ts tests/unit/staff-stage-writes.test.ts tests/unit/staff-job-writes.test.ts tests/unit/staff-admin-writes.test.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/client": "5.22.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.14",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.4",
    "selfsigned": "^5.5.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.169.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
