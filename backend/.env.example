# Copy to backend/.env OR reuse the repo-root .env (settings load both).
# Never commit real secrets.

DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Same Postgres as Prisma / Next.js — do not point at a second database.
DATABASE_URL=postgresql://ats:ats_local_dev@localhost:55432/ai_recruitment_os?schema=public

REDIS_URL=redis://127.0.0.1:6379/0

# Next.js session JWT (same secret as the live app). Django validates; it does not issue.
# Loaded from repo-root .env when present.
# AUTH_SECRET=
# AUTH_COOKIE_NAME=aros_session
# AUTH_TOKEN_TTL_HOURS=12

# Same local services as Next.js
AI_PROVIDER=local
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
SPEECH_SERVICE_URL=http://localhost:8001
STORAGE_ROOT=../storage

# Next.js Phase 4A BFF calls this origin with the existing aros_session cookie.
# Do not put AUTH_SECRET in NEXT_PUBLIC_* variables.
