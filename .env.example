# ── Database (local Docker Postgres + pgvector) ─────────────────────────────
# Host-dev: `npm run dev` auto-starts Postgres via scripts/ensure-local-db.mjs
# Manual: npm run db:ensure   (or docker compose up -d postgres → port 55432)
# Full pilot stack: see .env.docker.example + docs/PACKAGING.md
DATABASE_URL="postgresql://ats:ats_local_dev@localhost:55432/ai_recruitment_os?schema=public"

# ── Auth (self-hosted JWT) ──────────────────────────────────────────────────
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME="aros_session"
AUTH_TOKEN_TTL_HOURS="12"

# ── Ollama (never OpenAI/Anthropic/etc.) ────────────────────────────────────
# AI_PROVIDER: "local" (default, production) | "cloud" (dev only)
AI_PROVIDER="local"
OLLAMA_LOCAL_URL="http://localhost:11434"
OLLAMA_CLOUD_URL="https://ollama.com"
# Required only when AI_PROVIDER=cloud — ignored for local
OLLAMA_API_KEY=""
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_CHAT_MODEL="qwen2.5:7b"
# Embeddings always use local Ollama (cloud has no embeddings API)
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ── Local file storage ──────────────────────────────────────────────────────
STORAGE_ROOT="./storage"

# ── Local speech-service (STT/TTS — never cloud) ────────────────────────────
SPEECH_SERVICE_URL="http://localhost:8001"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Logisoft HireOS"
# Public base URL for links/QR (optional).
# Leave as localhost for local UI; secondary-camera QR uses PUBLIC_LAN_IP / auto LAN.
# Set explicitly only if needed, e.g. http://192.168.1.10:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Auto-filled by npm run db:ensure / predev — Wi‑Fi IPv4 for phone QR pairing
# PUBLIC_LAN_IP=192.168.x.x
# HTTPS for phone camera (Secure Context) — npm run https:up
# PUBLIC_HTTPS_URL=https://192.168.x.x:3443
# PUBLIC_HTTPS_PORT=3443

# ── Email (optional local SMTP relay — never cloud ESP) ─────────────────────
# If SMTP_HOST is unset, compose uses clipboard mode (draft log + copy buttons).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="recruiting@localhost"
