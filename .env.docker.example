# Copy to .env.docker and adjust before: docker compose --env-file .env.docker up -d --build
#   cp .env.docker.example .env.docker

POSTGRES_USER=ats
POSTGRES_PASSWORD=ats_local_dev
POSTGRES_DB=ai_recruitment_os
POSTGRES_HOST_PORT=55432

APP_HOST_PORT=3000
OLLAMA_HOST_PORT=11434
SPEECH_HOST_PORT=8001

# AUTH_SECRET lives ONLY in `.env` (single source of truth for host + Docker).
# Compose interpolates it via: docker compose --env-file .env.docker --env-file .env
# Do not put a second AUTH_SECRET here — mismatched values break JWT tests (401).
AUTH_COOKIE_NAME=aros_session
AUTH_TOKEN_TTL_HOURS=12

AI_PROVIDER=local
OLLAMA_API_KEY=
# Prefer a mid-size local chat model for pilots (~4–5GB). Avoid huge tags like qwen3.6:latest (~23GB).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

NEXT_PUBLIC_APP_NAME=Logisoft HireOS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed on first boot only (set true once, then false)
RUN_SEED=false

# Speech (CPU defaults in container)
WHISPER_MODEL=small
WHISPER_MODEL_CPU=small
PIPER_VOICE=en_US-lessac-medium
